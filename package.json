{
  "name": "embedded-map",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "husky && npm run generate-sprites && npm run extract-theme-variables",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --fix",
    "preview": "vite preview",
    "check-types": "tsc --noemit -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "cd e2e/config && docker compose run --rm test",
    "test:e2e:update": "cd e2e/config && UPDATE_SNAPSHOTS=true UPDATE_HARS=true docker compose run --rm test",
    "extract-sprites": "tsx scripts/extract-sprites.ts",
    "extract-theme-variables": "tsx scripts/extract-theme-variables.ts && npm run lint",
    "generate-sprites": "tsx scripts/generate-sprites.ts",
    "update-health-check": "tsx scripts/update-health-check.ts"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@arcgis/core": "~5.0.19",
    "@arcgis/map-components": "~5.0.19",
    "@fontsource-variable/work-sans": "^5.2.8",
    "@mantine/hooks": "^9.2.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.7",
    "react": "^19.2.6",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.6",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@swc/core": "^1.15.33",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "^4",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svgo": "^4.0.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8",
    "vitest": "^4"
  }
}
