{
  "name": "embedded-map",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "husky && npm run generate-sprites && npm run extract-theme-variables",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --fix",
    "preview": "vite preview",
    "check-types": "tsc --noemit -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "cd e2e/config && docker compose run --rm test",
    "test:e2e:update": "cd e2e/config && UPDATE_SNAPSHOTS=true UPDATE_HARS=true docker compose run --rm test",
    "test:e2e:update-snapshots": "cd e2e/config && UPDATE_SNAPSHOTS=true docker compose run --rm test",
    "extract-sprites": "tsx scripts/extract-sprites.ts",
    "extract-theme-variables": "tsx scripts/extract-theme-variables.ts && npm run lint",
    "generate-sprites": "tsx scripts/generate-sprites.ts",
    "update-health-check": "tsx scripts/update-health-check.ts"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@arcgis/core": "~5.1.27",
    "@arcgis/map-components": "~5.1.27",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@mantine/hooks": "^9.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.20",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "^4",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svgo": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8",
    "vitest": "^4"
  }
}
