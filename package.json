{
  "name": "embedded-map",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "husky && npm run generate-sprites && npm run extract-theme-variables",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --fix",
    "preview": "vite preview",
    "check-types": "tsc --noemit -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "cd e2e/config && docker compose run --rm test",
    "test:e2e:update": "cd e2e/config && UPDATE_SNAPSHOTS=true UPDATE_HARS=true docker compose run --rm test",
    "extract-sprites": "tsx scripts/extract-sprites.ts",
    "extract-theme-variables": "tsx scripts/extract-theme-variables.ts && npm run lint",
    "generate-sprites": "tsx scripts/generate-sprites.ts",
    "update-health-check": "tsx scripts/update-health-check.ts"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@arcgis/core": "~5.0.0",
    "@arcgis/map-components": "~5.0.0",
    "@fontsource-variable/work-sans": "^5.2.5",
    "@mantine/hooks": "^9.2.1",
    "@tailwindcss/vite": "^4.1.7",
    "@tanstack/react-router": "^1.97.3",
    "react": "^19.0.0",
    "react-aria-components": "^1.6.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.0",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.59.0",
    "@swc/core": "^1.11.1",
    "@tanstack/eslint-plugin-router": "^1.115.0",
    "@tanstack/router-devtools": "^1.97.3",
    "@tanstack/router-plugin": "^1.97.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react-swc": "^4",
    "cheerio": "^1.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-compiler": "^19.0.0-beta-aeaed83-20250323",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "svgo": "^3.3.2",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8",
    "vitest": "^4"
  }
}
